# ==============================================================================
# PROJECT ENVIRONMENT SAMPLE
# ==============================================================================
# Copy me into your project as .env:
#   cp ~/.config/zsh/gmake/.env.project.sample ~/projects/<name>/.env
#
# The gmake Makefile loads .env.global (shared defaults) first, then this
# file — every value set here wins for this project only.
#
# RULE: anything that identifies THIS project lives here, never in
# .env.global — GCP project, resource names, service names.
# ==============================================================================

# --- GCP identity (required by most targets) ---
# Example: GCP_PROJECT=my-project-id
GCP_PROJECT=

# --- Compute Engine (VM) ---
# Example: INSTANCE=my-vm-instance
INSTANCE=
# Example: MACHINE_TYPE=e2-standard-2
MACHINE_TYPE=
# Example: SA_NAME=my-project-vm-sa
SA_NAME=
# Script sent to the VM by gmake vm_run_script (path relative to the project root)
# Example: VM_SCRIPT=scripts/setup_vm.sh
VM_SCRIPT=

# --- Storage & BigQuery ---
# Example: BUCKET_NAME=my-data-bucket
BUCKET_NAME=
# Example: BQ_DATASET=my_dataset
BQ_DATASET=
# Optional, for table-level targets
# Example: TABLE_NAME=my_table
TABLE_NAME=

# --- Docker & Cloud Run ---
# Example: GAR_IMAGE=my-api
GAR_IMAGE=
# Example: PACKAGE_NAME=my-package
PACKAGE_NAME=
# Example: DOCKER_BASE_IMAGE=python:3.10.6-slim
DOCKER_BASE_IMAGE=
# Example: DOCKER_LOCAL_IMAGE=my_project-image
DOCKER_LOCAL_IMAGE=
# Example: ARTIFACTSREPO=my-artifacts
ARTIFACTSREPO=
# Cloud Run access: leave empty for a private service (authenticated
# invocations), set to true to expose a public URL (e.g. demos)
CLOUDRUN_PUBLIC=

# --- Populated after deployment (gmake cloudrun_url), read by Cloud API tests ---
# Example: SERVICE_URL=https://my-api-123456789-ew.a.run.app
SERVICE_URL=
