# ==============================================================================
# PROJECT ENVIRONMENT SAMPLE
# ==============================================================================
# What THIS project needs. The gmake Makefile loads the shared .env.global
# first, then this file — every value set here wins for this project only.
#
# Build your copy and fill it in:
#   gmake env_project_enable
#
# That command reads this sample and every pack's, and writes ./.env — adding
# the variables that are missing, never rewriting one that is already there.
#
# RULE: anything that identifies THIS project lives here, never in
# .env.global — project ids, resource names, service names.
# ==============================================================================

# --- The application package and its container ---
# Example: PACKAGE_NAME=my-package
PACKAGE_NAME=
# Example: DOCKER_BASE_IMAGE=python:3.10.6-slim
DOCKER_BASE_IMAGE=
# Example: DOCKER_LOCAL_IMAGE=my_project-image
DOCKER_LOCAL_IMAGE=

# A pack adds the variables it needs below this line: they sit next to its
# modules, and `gmake env_project_enable` copies them in.
