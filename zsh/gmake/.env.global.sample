# ==============================================================================
# GLOBAL ENVIRONMENT SAMPLE
# ==============================================================================
# Copy me to .env.global in the same directory and fill in your shared
# defaults:
#   cp ~/.config/zsh/gmake/.env.global.sample ~/.config/zsh/gmake/.env.global
#
# The global Makefile loads this for EVERY project, before the project's own
# .env (which always wins).
#
# RULE: only values shared by ALL your projects belong here — geographic and
# technical defaults, machine-level settings. Anything that identifies a
# specific project goes in that project's .env (see .env.project.sample).
# ==============================================================================

# --- Geographic defaults (same for all your projects) ---
# Example: GCP_REGION=europe-west1
GCP_REGION=
# Example: ZONE=europe-west1-b
ZONE=
# Dataset location for BigQuery
BQ_REGION=EU

# --- VM image defaults (generic — keep the values) ---
IMAGE_FAMILY=ubuntu-2204-lts
IMAGE_PROJECT=ubuntu-os-cloud

# --- Cloud Run default memory ---
# Example: GAR_MEMORY=2Gi
GAR_MEMORY=

# --- GCP SDK: one key for all your work (optional) ---
# Example: GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcp-key.json
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Optional default template for direct copier_project/cruft_project calls
# (fnew always picks from the catalog interactively) ---
# PROJECT_TEMPLATE_REPO=
# PROJECT_TEMPLATE_VERSION=
