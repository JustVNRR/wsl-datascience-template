# ==============================================================================
# 🏗️ PROJECT SCAFFOLDING
# ==============================================================================
# Default template repository for `gmake copier_project` / `gmake cruft_project`.
# Browse the curated catalog interactively with `fnew`
# (edit cheatsheets/templates.tsv to manage the available templates).
# Example: PROJECT_TEMPLATE_REPO=gh:felixgwilliams/python-copier-template-ds
# PROJECT_TEMPLATE_REPO=

# Optional pinned version/branch (cruft_project only)
# Example: PROJECT_TEMPLATE_VERSION=v1
# PROJECT_TEMPLATE_VERSION=

# ==============================================================================
# ⚙️ GLOBAL GCP CONFIGURATION
# ==============================================================================
# Example: GCP_PROJECT=mon-projet-gcp-id
GCP_PROJECT=
# Example: GCP_REGION=europe-west1
GCP_REGION=

# Path to your GCP Service Account JSON key (mandatory for local/tests)
# Example: GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your/gcp-key.json
# GOOGLE_APPLICATION_CREDENTIALS=

# ==============================================================================
# 🖥️ COMPUTE ENGINE (VM) & IAM
# ==============================================================================
# Example: ZONE=europe-west1-b
ZONE=
# Example: INSTANCE=my-vm-instance
INSTANCE=
# Example: MACHINE_TYPE=e2-standard-2
MACHINE_TYPE=
# Example: IMAGE_FAMILY=ubuntu-2204-lts
IMAGE_FAMILY=ubuntu-2204-lts
# Example: IMAGE_PROJECT=ubuntu-os-cloud
IMAGE_PROJECT=ubuntu-os-cloud
# Example: SA_NAME=my-project-vm-sa
SA_NAME=

# ==============================================================================
# 🗄️ STORAGE & BIGQUERY
# ==============================================================================
# Example: BQ_REGION=EU
BQ_REGION=EU

# ==============================================================================
# 🐳 DOCKER & CLOUD RUN
# ==============================================================================
# Example: GAR_MEMORY=2Gi
GAR_MEMORY=
# Example: DOCKER_BASE_IMAGE=python:3.10.6-slim
DOCKER_BASE_IMAGE=

# SERVICE_URL is populated after Cloud Run deployment (used for Cloud API tests)
# Example: SERVICE_URL=https://my-api-image-123456789-ew.a.run.app
# SERVICE_URL=

# ==============================================================================
# 📊 DATA & PIPELINE CONFIGURATION
# ==============================================================================
# Example: DATA_SIZE=1k
DATA_SIZE=
# Example: CHUNK_SIZE=100000
CHUNK_SIZE=
# Example: MODEL_TARGET=mlflow (options: local, gcs, mlflow)
MODEL_TARGET=

# ==============================================================================
# ⏱️ PREFECT & SCHEDULING
# ==============================================================================
# Example: PREFECT_FLOW_NAME=my_main_flow
PREFECT_FLOW_NAME=
# Example: PREFECT_LOG_LEVEL=INFO
PREFECT_LOG_LEVEL=
# Example: EVALUATION_START_DATE=2024-01-01
EVALUATION_START_DATE=

# ==============================================================================
# 🔔 NOTIFICATIONS (WEBHOOKS)
# ==============================================================================
# Example: NOTIFY_BASE_URL=https://hooks.slack.com/services/...
NOTIFY_BASE_URL=
# Example: NOTIFY_CHANNEL=#alerts
NOTIFY_CHANNEL=
# Example: NOTIFY_AUTHOR=Data_Pipeline_Bot
NOTIFY_AUTHOR=
