# WSL and Docker build artifacts
*.tar
*.tar.gz
*.vhdx

# Zsh runtime compilation caches and history
*.zcompdump*
.zsh_history
.bash_history

# OS and IDE files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Python scratch state: this repository carries no Python - the projects live
# under ~/projects, and the toolchain comes with the python pack - but an
# experiment run from this checkout should not end up committed
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local environment files (filled-in copies of the *.sample contracts)
.env
.env.*
!*.sample

# Per-machine tooling state. This folder holds Claude Code's local settings -
# permission rules that name paths on THIS machine - and the notes taken while
# working on the repository. Neither belongs to a colleague or to the published
# repository: both would arrive in a clone as untracked files to commit by
# mistake.
.claude/