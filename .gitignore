# WSL and Docker build artifacts
*.tar
*.tar.gz
*.vhdx

# Zsh runtime compilation caches and history
*.zcompdump*
.zsh_history
.bash_history

# OS and IDE files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Python scratch state: this repository carries no Python - the projects live
# under ~/projects, and the toolchain comes with the python pack - but an
# experiment run from this checkout should not end up committed
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local environment files (filled-in copies of the *.sample contracts)
.env
.env.*
!*.sample

# Per-machine editor/tooling state. settings.local.json holds the permission
# rules Claude Code picked up while working in this checkout: it names paths on
# THIS machine and means nothing to a colleague, who would see it as an
# untracked file to commit by mistake.
.claude/settings.local.json