# ==============================================================================
# CLAUDE - SHARED DEFAULTS (the claude pack)
# ==============================================================================
# Which provider this instance talks to - the id of an entry in the dictionary
# the pack seeded at ~/.config/claude/profiles.json, which `gmake claude_profile`
# writes here when you choose one, and which `gmake claude_edit_profiles` opens.
#
# An instance that never ran the target has no line here at all, and that is a
# state like any other: the settings and the login decide, which is what a fresh
# machine looks like.
#
# `gmake env_global_enable` copies this block into
# ~/.config/zsh/gmake/.env.global the first time it runs; after that it only
# adds what is missing.
#
# Nothing reads this file: it is a sample. The filled copy in .env.global is
# what gmake loads - and, since a gmake run loads it, the value below is also
# what `gmake claude_profile` writes back when you pick the same provider.
# ==============================================================================

# --- Which provider this instance talks to ---
# `gmake claude_profile` chooses from the dictionary; naming one on the command
# line (`gmake claude_profile CLAUDE_PROFILE=gateway`) applies it without the
# menu. The dictionary is the source: a change made to a token in it is written
# again by the next gmake claude_profile, nothing else keeps them in step.
CLAUDE_PROFILE=claude
