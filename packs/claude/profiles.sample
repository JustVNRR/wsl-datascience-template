{
  "note": "One entry per provider. The id is what the menus show and what CLAUDE_PROFILE names. An entry with no env is this instance's own login (your subscription) - choosing it takes back whatever another profile had put in ~/.claude/settings.json. A profile that carries a base_url must carry a credential too: a base URL alone would send your claude.ai login to that address. What a profile writes is the ANTHROPIC_* keys, plus anything its own env holds. gmake claude_edit_profiles opens this file.",
  "profiles": [
    {
      "id": "claude",
      "note": "the instance's own login - no env at all"
    },
    {
      "id": "gateway",
      "note": "an endpoint that speaks the Anthropic API. Replace the base_url and paste your token; add \"model\" to pin one, and an \"env\" object for anything else that provider asks for.",
      "base_url": "https://your-gateway.example/api/anthropic",
      "token": "PASTE-YOUR-TOKEN-HERE"
    }
  ]
}
