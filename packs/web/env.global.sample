# ==============================================================================
# THE TUNNEL - SHARED DEFAULTS (the web pack)
# ==============================================================================
# What the tunnel targets read: which server, and whether it takes a kill switch.
# `gmake env_global_enable` copies this block into
# ~/.config/zsh/gmake/.env.global the first time it runs; after that it only adds
# what is missing.
#
# The values are values of the machine, not of a project: the tunnel carries this
# instance's traffic, whichever directory a target is run from.
#
# Nothing reads this file: it is a sample. The filled copy in .env.global is what
# gmake loads - and what the boot hook reads when the distro starts, so the two
# cannot disagree.
# ==============================================================================

# --- Which server the tunnel uses, and the distro starts with ---
# An id of ~/.config/vpn/servers.json, the file `gmake vpn_edit_profiles` opens.
# `gmake vpn_server` picks one and writes it here.
VPN_PROFILE=server-1

# --- The resolver out of tunnel, and the tunnel's MTU ---
# BASE_DNS: what the instance resolves with while no tunnel is up. The tunnel's
# own DNS belongs to the server, in its entry of ~/.config/vpn/servers.json.
# VPN_MTU: the tunnel's MTU, for every server whose entry says nothing - an
# entry carrying its own "mtu" wins.
BASE_DNS=1.1.1.1
VPN_MTU=1420

# --- The kill switch ---
# true: the tunnel rejects whatever would leave outside it (two iptables lines in
# the profile). false: it does not. `gmake vpn_ks_on` and `vpn_ks_off` write this
# line, and remount the tunnel so the answer is true right away.
VPN_KILL_SWITCH=true
