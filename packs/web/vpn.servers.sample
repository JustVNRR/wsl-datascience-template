      "private_key": "PASTE-YOUR-PRIVATE-KEY-HERE",
      "peer": {
        "public_key": "PASTE-THE-SERVER-PUBLIC-KEY-HERE",
        "endpoint": "198.51.100.1:51820",
        "allowed_ips": "0.0.0.0/0, ::/0"
      }
    }
  ]
