# ==============================================================================
# A WIREGUARD PROFILE - THE SHAPE, WITHOUT THE KEYS
# ==============================================================================
# This is what the pack leaves in /etc/wireguard/ when the folder holds no
# profile at all: the lines that are painful to find again, and none of the ones
# that are yours. The two keys and the address come from your Proton account -
# Downloads, "WireGuard configuration" - and are the only things to paste.
#
# One file per server: proton.conf, ch.conf, nl.conf. The file's name is the
# name `gmake vpn_up` offers, and the name the distro can start with
# (`gmake vpn_auto_on`). The pack never writes in them: they carry your private
# key, and they are yours.

[Interface]
# Your private key, and the address Proton gives it, as they come out of the
# .conf Proton generates. Proton writes an IPv4 address and an IPv6 one on the
# same line - keep both, or the v6 half of the traffic stays outside.
PrivateKey = PASTE-YOUR-PRIVATE-KEY-HERE
Address    = 10.2.0.2/32, 2001:db8::2/128

# Proton's own resolver, inside the tunnel. openresolv is what applies it (the
# pack installs it), and /etc/resolv.conf goes back to what it was when the
# tunnel goes down.
DNS        = 10.2.0.1

# The tunnel adds its own header to every packet, and it does not fit in the
# 1500 bytes of the WSL interface: without this line the large ones are dropped
# in silence - a page that loads halfway, a clone that stops moving. 1420 is the
# usual value; lower it if the symptom persists.
MTU        = 1420

# Kill switch: while the tunnel is up, everything that would leave outside it is
# rejected. The mark is the one wg-quick puts on its own packets, and LOCAL
# destinations (loopback, WSLg, the Docker socket) are spared - without that
# last part, the terminal this was typed in would go quiet first.
PostUp     = iptables -I OUTPUT ! -o %i -m mark ! --mark $(wg show %i fwmark) -m addrtype ! --dst-type LOCAL -j REJECT && ip6tables -I OUTPUT ! -o %i -m mark ! --mark $(wg show %i fwmark) -m addrtype ! --dst-type LOCAL -j REJECT
PreDown    = iptables -D OUTPUT ! -o %i -m mark ! --mark $(wg show %i fwmark) -m addrtype ! --dst-type LOCAL -j REJECT && ip6tables -D OUTPUT ! -o %i -m mark ! --mark $(wg show %i fwmark) -m addrtype ! --dst-type LOCAL -j REJECT

[Peer]
# The server's public key and its address, from the same file.
PublicKey  = PASTE-THE-SERVER-PUBLIC-KEY-HERE
AllowedIPs = 0.0.0.0/0, ::/0
Endpoint   = SERVER-ADDRESS:51820
